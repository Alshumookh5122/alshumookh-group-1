# Private key of deployer wallet
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# RPC endpoint
RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

# BscScan API key for contract verification
BSCSCAN_API_KEY=YOUR_BSCSCAN_API_KEY

# Address to set as initial owner of the distributor
INITIAL_OWNER=0xYOUR_OWNER_ADDRESS

# Deployed distributor contract address (fill after deployment)
DISTRIBUTOR_ADDRESS=0xDISTRIBUTOR_ADDRESS

# ERC20 token address to use for depositToken script
TOKEN_ADDRESS=0xTOKEN_ADDRESS

# Amount to deposit (in token smallest unit)
DEPOSIT_AMOUNT=1000000000000000000

# JSON array of payee addresses
PAYEES_JSON=["0xAddress1","0xAddress2"]

# JSON array of BPS shares (must sum to 10000)
SHARES_JSON=[7000,3000]
